# Renommer ce fichier en  .env  (exactement, sans .txt) a cote de MediLogicOffline.exe
# et remplacer chaque valeur. Les 3 premieres se copient EXACTEMENT depuis
# Render (dashboard.render.com > service GHP > Environment).
DATABASE_URL=postgresql://...
SPREADSHEET_ID=...
PATIENT_ENCRYPTION_KEY=...
# Numero de LA structure servie par CE PC (un PC = une seule structure).
OFFLINE_STRUCTURE_ID=1
ONLINE_APP_URL=https://medilogic-ghp.onrender.com
# Optionnel : second emplacement de sauvegarde (cle USB, dossier reseau).
# OFFLINE_BACKUP_DIR=D:\Sauvegardes_MediLogic
